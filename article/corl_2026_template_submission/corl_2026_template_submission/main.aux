\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Network architectures.} (\emph  {Left}) ActorMLP maps the 270-D observation to a 6-D mean action; a shared log-std vector $\mathbf  {s}\in \mathbb  {R}^6$ controls stochasticity. (\emph  {Right}) The Q-critic decomposes the observation into semantic ($\mathbf  {f}_\text  {sem}$), geometric ($\mathbf  {f}_\text  {geo}$), safety ($\mathbf  {f}_\text  {oob}$), and kinematic features before the shared MLP head.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:architectures}{{2}{5}{\textbf {Network architectures.} (\emph {Left}) ActorMLP maps the 270-D observation to a 6-D mean action; a shared log-std vector $\mathbf {s}\in \mathbb {R}^6$ controls stochasticity. (\emph {Right}) The Q-critic decomposes the observation into semantic ($\mathbf {f}_\text {sem}$), geometric ($\mathbf {f}_\text {geo}$), safety ($\mathbf {f}_\text {oob}$), and kinematic features before the shared MLP head}{figure.2}{}}
