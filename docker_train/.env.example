# ── Paths ────────────────────────────────────────────────────────────────────
# Directory that contains model_best.pth (mounted read-only at /data/weights)
WEIGHTS_DIR=../weights

# SAC training output directory (checkpoints, metrics CSVs, videos)
OUTPUT_DIR=./output

# Evaluation output directory (eval CSVs, HTML visualizations)
EVAL_OUTPUT_DIR=./eval_output

# ── ODIN ─────────────────────────────────────────────────────────────────────
ODIN_WEIGHTS=/data/weights/model_best.pth
ODIN_CFG=/workspace/odin/configs/scannet_context/3d.yaml

# Enable SWAG Bayesian inference (10 MC samples). true | false
SWAG=false

# ── SAC Training  (train_sac.sh) ─────────────────────────────────────────────
# Policy to run: sac | geometric | uncertainty
POLICY=sac

TOTAL_STEPS=200000
SCENE_STAGE=2          # 1=open  2=with obstacles  3=full robot arm
MAX_STEPS=10           # max env steps per episode

# Freeze ODIN backbone — train only NBV head + ActorMLP + critics.
# Set false for full end-to-end fine-tuning.
FREEZE_BACKBONE=true

LEARNING_STARTS=1000
BATCH_SIZE=64
GRADIENT_STEPS=4
LR_ACTOR=0.0001
LR_CRITIC=0.0003

# ── Evaluation  (evaluate.sh) ────────────────────────────────────────────────
# Path to a SAC .pth checkpoint to load for the 'sac' policy.
# Leave empty to use random SAC weights (baselines still work).
CHECKPOINT=/workspace/output/best.pth

# Space-separated list of policies to evaluate and compare.
POLICIES=sac geometric uncertainty

NUM_EPISODES=50
